{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    }
  },
  "Bridge": {
    "ListenAddress": "0.0.0.0",
    "Port": 5088,
    "Token": "",
    "PollIntervalMs": 30,
    "LevelPollIntervalMs": 50,
    "ReconnectIntervalMs": 2000,
    "MaxSetsPerSecondPerParameter": 20,
    "HelloTimeoutMs": 5000,
    "DllPath": ""
  },
  "AllowedHosts": "*"
}
